VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

VITE_AGROMONITORING_API_KEY=your-agromonitoring-api-key
VITE_MAPBOX_API_KEY=your-mapbox-api-key

# TiTiler - Local tile server for drone imagery
VITE_TITILER_URL=http://localhost:8000

# Compute backend (ml-models)
VITE_COMPUTE_API_URL=http://localhost:8001

# Web3Auth (https://dashboard.web3auth.io)
VITE_WEB3AUTH_CLIENT_ID=your-web3auth-client-id

# Biconomy (https://dashboard.biconomy.io) - required for gasless smart account
VITE_BICONOMY_BUNDLER_URL=https://bundler.biconomy.io/api/v2/11155111/your-key
VITE_BICONOMY_PAYMASTER_URL=https://paymaster.biconomy.io/api/v1/11155111/your-key
